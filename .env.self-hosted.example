# Public URLs used by browsers and local connectors. Self-hosted mode disables
# hosted checkout/license-row enforcement; it does not change the rights
# granted by LICENSE.md.
GROOVY_EDITION=self-hosted
GROOVY_APP_URL=http://localhost:3000
GROOVY_RELAY_URL=ws://localhost:8080
GROOVY_WEB_PORT=3000
GROOVY_RELAY_PORT=8080
NEXT_PUBLIC_BRAND_NAME=Groovy

# Use a hosted Supabase project, or the values printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Generate independent high-entropy values. Never reuse the Supabase keys.
RELAY_JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
LLM_KEY_ENCRYPTION_KEY=REPLACE_WITH_A_32_BYTE_OR_LONGER_SECRET
HARNESS_THREAD_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET
SCHEDULER_CRON_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# On Vercel, set CRON_SECRET to the same value as SCHEDULER_CRON_SECRET so
# platform cron requests and relay ticks share the scheduler auth boundary.
CRON_SECRET=REPLACE_WITH_THE_SAME_SCHEDULER_SECRET

# Optional server-side model keys. Users can instead save encrypted keys in UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Memory falls back to the private Wiki when these are unset;
# Datagran-backed Memory/Data Integrations require a Datagran account.
DATAGRAN_API_KEY=
DATAGRAN_CHAT_MODEL=
